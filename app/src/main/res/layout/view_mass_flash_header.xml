<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/tvMassHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_mass_header" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" android:visibility="gone" />
  <TextView android:id="@+id/tvMassPartitionLabel" android:labelFor="@id/spinMassPartition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_partition_label" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="4dp" />
  <Spinner android:id="@+id/spinMassPartition" android:spinnerMode="dropdown" android:popupBackground="@color/bg_elevated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_sideload_file" android:minHeight="48dp" />
  <EditText android:id="@+id/edMassManualPartition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_sideload_file" android:hint="@string/flash_rev7_manual_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:inputType="text" android:singleLine="true" android:padding="10dp" android:visibility="gone" android:minHeight="48dp" android:importantForAutofill="no" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnMassSelectImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_add_image" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" android:minHeight="48dp" />
  <TextView android:id="@+id/tvMassQueueTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_queue_empty" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
  <TextView android:id="@+id/tvMassSourceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/log_warning" android:paddingBottom="8dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
  <TextView android:id="@+id/tvMassQueueEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rev25_queue_empty_hint" android:textSize="14sp" android:textColor="@color/text_muted" android:paddingTop="12dp" android:paddingBottom="24dp" />
</LinearLayout>
