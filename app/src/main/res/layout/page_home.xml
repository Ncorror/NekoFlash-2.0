<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Device facts only. REV7: no actions or operation history on Home. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHomeDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/ivHomeDevicePhoto"
                        android:layout_width="96dp"
                        android:layout_height="116dp"
                        android:padding="16dp"
                        android:src="@drawable/ic_device_placeholder"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_otg_strip"
                        android:contentDescription="@string/home_device_image_placeholder" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvDeviceProductValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_model_empty"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDeviceModeValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/layout_mode_empty"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvDeviceWorkspaceValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/device_transport_placeholder"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_actual_device_facts"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvHomeCodename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/home_codename_unknown"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDeviceAndroidValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/home_android_unknown"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDeviceUnlockedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/layout_bl_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDeviceSlotValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/layout_slot_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <!-- Kept only as a compatibility listener target; refresh is not
                     an additional prominent Home action. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHomeRefreshData"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeAdvancedToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/home_advanced_information"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            app:backgroundTint="@color/bg_elevated" />
        <LinearLayout
            android:id="@+id/homeAdvancedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvDeviceMaxDownloadValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_max_dl_empty"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeSpecsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_model_specs"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            app:backgroundTint="@color/bg_elevated" />
        <TextView
            android:id="@+id/homeModelSpecs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:padding="12dp"
            android:text="@string/home_specs_unavailable"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Bound with the Activity, then hosted in the contextual sheet. -->
        <include layout="@layout/view_operation_center" />



    </LinearLayout>
</ScrollView>
