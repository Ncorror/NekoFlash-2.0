<?xml version="1.0" encoding="utf-8"?>
<!--
    NekoFlash welcome shell.
    CRITICAL: @drawable/bg_welcome is the user's original immutable artwork.

    The artwork fills the complete content viewport. The title is anchored at the top and the
    compact outline-first action gate is anchored at the bottom as a translucent overlay.
    This avoids both the large dark tail and the two-position ScrollView crop seen on some
    portrait displays while keeping every permission/risk control in the same order.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/welcomeHeroArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_base">

        <ImageView
            android:id="@+id/imgWelcomeBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/onboarding_bg_desc"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_welcome" />

        <LinearLayout
            android:id="@+id/welcomeTitleBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/welcome_top_padding"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#E0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="@string/app_name_neko"
                    android:textColor="@color/accent"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#E0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="@string/app_name_flash"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#E0000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="7"
                android:text="@string/onboarding_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/welcomeBottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/welcome_bottom_padding"
        android:background="@drawable/bg_welcome_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/welcome_panel_padding_horizontal"
        android:paddingTop="@dimen/welcome_panel_padding_vertical"
        android:paddingEnd="@dimen/welcome_panel_padding_horizontal"
        android:paddingBottom="@dimen/welcome_panel_padding_vertical">

        <!-- REV10: one readable permission action instead of three truncated chips. -->
        <TextView
            android:id="@+id/tvStorageChip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_welcome_chip"
            android:contentDescription="@string/onboarding_storage_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawablePadding="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/onboarding_storage_grant"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <!-- Kept as hidden IDs for unchanged optional system-permission flows. -->
        <TextView android:id="@+id/tvNotificationsChip"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvBatteryChip"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/riskRow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/welcome_risk_row_height"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_welcome_status_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <CheckBox
                android:id="@+id/checkboxAgree"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:buttonTint="@color/accent"
                android:enabled="false"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/onboarding_agree_text_short"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWelcomeStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/welcome_status_height"
            android:layout_marginTop="4dp"
            app:drawableStartCompat="@drawable/ic_status_optional_gray"
            android:drawablePadding="7dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/onboarding_need_storage_short"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/welcome_primary_button_height"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_welcome_primary_button"
            android:backgroundTint="@null"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawablePadding="10dp"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="@string/onboarding_enter_button"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />
    </LinearLayout>
</FrameLayout>
