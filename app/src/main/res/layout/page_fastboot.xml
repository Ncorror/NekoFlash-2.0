<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerFastboot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">


        <!-- Approved inner sections: Quick / Mass / Fastboot tools. -->
        <LinearLayout android:id="@+id/flashWorkflowSectionButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
           <com.google.android.material.button.MaterialButton android:id="@+id/btnFastbootSectionQuick" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="@string/flash_rev7_quick" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnFastbootSectionMass" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="@string/flash_rev7_mass" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnFastbootSectionTools" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="@string/flash_rev7_tools" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" />
        </LinearLayout>
        <LinearLayout android:id="@+id/fastbootQuickSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible" android:padding="12dp">
<TextView android:id="@+id/tvQuickHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_quick_header" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<TextView android:id="@+id/tvQuickPartitionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_partition_label" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<Spinner android:id="@+id/spinQuickPartition" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_sideload_file" />
<EditText android:id="@+id/edQuickManualPartition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_sideload_file" android:hint="@string/flash_rev7_manual_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:inputType="text" android:singleLine="true" android:padding="10dp" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnQuickSelectImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_choose_image" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" />
<TextView android:id="@+id/tvQuickSelectedImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_no_image" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<TextView android:id="@+id/tvQuickSlotLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_slot_label" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<Spinner android:id="@+id/spinQuickSlot" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_sideload_file" />
<TextView android:id="@+id/tvQuickTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_target_unselected" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnQuickExecute" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_flash" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" />
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" android:layout_marginVertical="8dp" />
<TextView android:id="@+id/tvQuickDeviceTools" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_device_control" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnQuickReboot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_reboot" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" />
</LinearLayout>
        <LinearLayout android:id="@+id/fastbootMassSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="12dp">
<TextView android:id="@+id/tvMassHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_mass_header" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<TextView android:id="@+id/tvMassPartitionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_partition_label" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<Spinner android:id="@+id/spinMassPartition" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_sideload_file" />
<EditText android:id="@+id/edMassManualPartition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_sideload_file" android:hint="@string/flash_rev7_manual_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:inputType="text" android:singleLine="true" android:padding="10dp" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnMassSelectImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_add_image" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" />
<TextView android:id="@+id/tvMassQueueTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_queue_empty" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<LinearLayout android:id="@+id/llMassQueueRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnMassExecute" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_flash_queue" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" />
</LinearLayout>
        <LinearLayout android:id="@+id/fastbootToolsSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="12dp">
<TextView android:id="@+id/tvFastbootToolsHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_tools_header" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnShowInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_info" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><LinearLayout android:id="@+id/toolBlockInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible" android:padding="12dp"><EditText android:id="@+id/edGetvarKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_sideload_file" android:hint="@string/flash_rev7_getvar_key" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:inputType="text" android:singleLine="true" android:padding="10dp" android:visibility="visible" /><com.google.android.material.button.MaterialButton android:id="@+id/btnToolGetvar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_getvar" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><com.google.android.material.button.MaterialButton android:id="@+id/btnToolInventory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_inventory" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnShowPartitions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_parts" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><LinearLayout android:id="@+id/toolBlockPartitions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="12dp"><EditText android:id="@+id/edToolPartition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_sideload_file" android:hint="@string/flash_rev7_manual_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:inputType="text" android:singleLine="true" android:padding="10dp" android:visibility="visible" /><com.google.android.material.button.MaterialButton android:id="@+id/btnToolErase" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_erase" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><com.google.android.material.button.MaterialButton android:id="@+id/btnToolBoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_boot" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><TextView android:id="@+id/tvToolFormatNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_format_pending" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" /></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnShowSlots" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_slots" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><LinearLayout android:id="@+id/toolBlockSlots" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="12dp"><com.google.android.material.button.MaterialButton android:id="@+id/btnToolSetSlotA" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_set_slot_a" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><com.google.android.material.button.MaterialButton android:id="@+id/btnToolSetSlotB" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_set_slot_b" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnShowDynamic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_dynamic" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><LinearLayout android:id="@+id/toolBlockDynamic" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="12dp"><EditText android:id="@+id/edToolLogicalPartition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_sideload_file" android:hint="@string/flash_rev7_manual_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:inputType="text" android:singleLine="true" android:padding="10dp" android:visibility="visible" /><com.google.android.material.button.MaterialButton android:id="@+id/btnToolInspectLogical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/flash_rev7_inspect_logical" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/bg_elevated" app:cornerRadius="12dp" /><TextView android:id="@+id/tvToolDynamicNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flash_rev7_dynamic_notice" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="8dp" /></LinearLayout>
</LinearLayout>
        <!-- Recovery-first Quick Flash: one image, one concrete target, one confirmation -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickFlashRecoveryFirst"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_flash_recovery_first_title"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/quick_flash_recovery_first_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBlockImportFastboot"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:contentDescription="@string/import_file_action_desc"
                        app:icon="@drawable/ic_nf_import"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="@null"
                        app:backgroundTint="@color/bg_elevated"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlashRecovery"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/quick_flash_primary_recovery"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    app:backgroundTint="#263A20"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_nf_recovery_green"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="24dp"
                    app:iconTint="@null"
                    app:strokeColor="#4E7A43"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/quick_flash_other_targets"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.PartitionTile"
                        android:id="@+id/btnFlashBoot"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/layout_partition_boot"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.PartitionTile"
                        android:id="@+id/btnFlashInitBoot"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:text="@string/layout_partition_init_boot"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerQuickFlashExpertTargets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.NekoFlash.PartitionTile"
                            android:id="@+id/btnFlashVendorBoot"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/layout_partition_vendor_boot"
                            android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.NekoFlash.PartitionTile"
                            android:id="@+id/btnFlashDtbo"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:text="@string/layout_partition_dtbo"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.NekoFlash.PartitionTile"
                        android:id="@+id/btnFlashVbmeta"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:text="@string/layout_partition_vbmeta"
                        android:textSize="11sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlashManual"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="7dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/quick_flash_manual_target"
                        android:textAllCaps="false"
                        android:textColor="#F2C98B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        app:backgroundTint="#2A2115"
                        app:cornerRadius="12dp"
                        app:strokeColor="#6C522C"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlashRebootMode"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/layout_flash_reboot_mode"
                    android:textAllCaps="false"
                    android:textColor="#F97316"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="#2A1C10"
                    app:strokeColor="#5A3A1E"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
</ScrollView>
